# GitHub MCP — Environment Variables
# Copy this to .env and fill in your values

# Personal Access Token (classic) with scopes: repo, read:org, read:user
# Generate at: https://github.com/settings/tokens
# Or use a Fine-Grained Token at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
